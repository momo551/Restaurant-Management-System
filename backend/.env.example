# Security
SECRET_KEY=your-secret-key-goes-here
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1,your-production-domain.com
# Origins allowed to call the API from a browser (comma-separated).
# Defaults to the local Vite dev servers only, so production MUST list the real
# admin and customer website origins or every cross-origin request is blocked.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174,https://restaurant-system-alpha.vercel.app
# Keep False. True disables the origin allow-list above entirely.
CORS_ALLOW_ALL_ORIGINS=False
# Required for the Django admin and any unsafe (POST/PUT/PATCH/DELETE) request
# coming from a different origin, e.g. the Railway backend host and the Vercel
# frontends. Scheme is required; wildcards like https://*.vercel.app are NOT
# supported by Django and must be listed explicitly.
CSRF_TRUSTED_ORIGINS=https://restaurant-system-alpha.vercel.app

# Database (PostgreSQL recommended for production)
DATABASE_URL=postgres://user:password@hostname:5432/dbname
# Or uncomment below for individual variables
# DB_ENGINE=django.db.backends.postgresql
# DB_NAME=yourdbname
# DB_USER=yourdbuser
# DB_PASSWORD=yourdbpassword
# DB_HOST=hostname
# DB_PORT=5432

# ─── Channel layer / background tasks ─────────────────────────────────────────
# No Redis is used anywhere in this project: there is deliberately NO REDIS_URL,
# no broker URL, and no celery queue. Django Channels runs on
# channels.layers.InMemoryChannelLayer (configured in core/settings.py), which
# is sufficient because the backend runs as ONE Daphne process (see Procfile).
#
# LIMITATION: the in-memory layer only shares messages inside a single process.
# WebSocket features (kitchen display, live order tracking) therefore keep
# working with one worker/replica, but they will NOT broadcast across multiple
# workers or replicas. That is a documented constraint, not a bug - do not add a
# Redis service to "fix" it without an explicit decision to change the design.

# Email settings
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your_email@gmail.com
EMAIL_HOST_PASSWORD=your_app_password
DEFAULT_FROM_EMAIL=your_email@gmail.com

# Cloudinary (Static/Media storage in production)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Security Settings for Production
SECURE_SSL_REDIRECT=True

# Sentry (Optional for error tracking)
# SENTRY_DSN=
